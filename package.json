{
  "name": "omarchy-widgets-web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite dev",
    "build": "bun run themes:gen && bun run registry && vite build && bun scripts/prune-demo.ts && bun scripts/finalize-errors.ts && bun run search-index",
    "preview": "vite preview",
    "build:hosts": "bun scripts/build-hosts.ts",
    "serve:local": "bun scripts/serve-local.ts",
    "emit:host-config": "bun scripts/emit-host-config.ts",
    "registry": "bun scripts/build-registry.ts",
    "stats:dev": "STATS_DEV=1 bun services/stats/scripts/dev-server.ts",
    "docs:sync": "bun scripts/sync-reference-docs.ts",
    "docs:snapshot": "bun scripts/docs-snapshot.ts",
    "search-index": "bunx pagefind --site build",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "lint": "prettier --check . && eslint .",
    "format": "prettier --write .",
    "themes:gen": "bun scripts/gen-themes.ts",
    "themes:check": "bun scripts/contrast-check.ts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "lock:add": "bun scripts/lock-add.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@sveltejs/adapter-static": "^4.0.0",
    "@sveltejs/kit": "^3.1.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^26.6.5",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "eslint": "^10.13.0",
    "eslint-plugin-svelte": "^3.23.1",
    "github-slugger": "^2.0.0",
    "hast-util-to-string": "^3.0.1",
    "mdast-util-from-markdown": "^2.1.0",
    "mdsvex": "^0.12.8",
    "pagefind": "^1.5.2",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-external-links": "^3.0.0",
    "rehype-slug": "^6.0.0",
    "shiki": "^4.5.0",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.7",
    "typescript": "^5.9",
    "typescript-eslint": "^8.72.0",
    "unist-util-visit": "^5.1.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "gsap": "^3.15.0"
  }
}
